---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="mb-6 flex flex-col gap-4">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        <form class="grid gap-4 rounded-xl border border-slate-700 bg-slate-800/60 p-4 md:grid-cols-2" data-testid="game-filters">
          <fieldset>
            <legend class="mb-2 text-sm font-medium text-slate-200">Categories</legend>
            <div class="grid gap-2 sm:grid-cols-2">
              {categories.map((category) => (
                <label class="flex items-center gap-2 text-sm text-slate-300">
                  <input
                    type="checkbox"
                    name="category"
                    value={category.id}
                    data-testid={`category-filter-${category.id}`}
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <div>
            <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
            <select
              id="publisher-filter"
              data-testid="publisher-filter"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
          </div>
          <div class="md:col-span-2 flex items-center justify-between gap-4">
            <p class="text-sm text-slate-400" data-testid="filter-results-count" aria-live="polite">
              Showing {games.length} games
            </p>
            <button
              type="reset"
              data-testid="clear-filters"
              class="rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-200 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            >
              Clear filters
            </button>
          </div>
        </form>
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      <p class="hidden py-8 text-center text-slate-300" data-testid="filtered-empty-state">
        No games match the selected filters.
      </p>
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-results-count"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];

  const updateFilters = (): void => {
    const selectedCategories = new Set(
      [...document.querySelectorAll<HTMLInputElement>('input[name="category"]:checked')].map(
        (input) => input.value,
      ),
    );
    const selectedPublisher = publisherFilter?.value ?? '';
    let visibleCount = 0;

    for (const card of cards) {
      const categoryMatches =
        selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
      const publisherMatches =
        selectedPublisher === '' || selectedPublisher === (card.dataset.publisherId ?? '');
      const visible = categoryMatches && publisherMatches;
      card.classList.toggle('hidden', !visible);
      if (visible) visibleCount += 1;
    }

    if (resultCount) resultCount.textContent = `Showing ${visibleCount} games`;
    emptyState?.classList.toggle('hidden', visibleCount !== 0);
  };

  filterForm?.addEventListener('change', updateFilters);
  filterForm?.addEventListener('reset', () => requestAnimationFrame(updateFilters));
</script>
